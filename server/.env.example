# ── Google AI Studio ──────────────────────────────────────────
# Lấy key tại https://aistudio.google.com/apikey  (KHÔNG commit key thật, KHÔNG đưa vào client)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# ── Database ─────────────────────────────────────────────────
# Để trống => tự động dùng Local Persistent JSON Store (server/data/store.json)
# Có giá trị (mongodb+srv://...) => dùng MongoDB Atlas qua Mongoose (2dsphere)
MONGODB_URI=

# ── Bảo mật ──────────────────────────────────────────────────
# Chuỗi ngẫu nhiên >= 32 ký tự. Bắt buộc ở production.
JWT_SECRET=
ALLOWED_ORIGINS=http://localhost:5173,https://*.onrender.com

# ── Vận hành ─────────────────────────────────────────────────
PORT=8080
NODE_ENV=development
# Trả mã OTP trong response (nhãn [DEMO OTP]) để Ban Giám Khảo thử không tốn phí SMS. Tắt ở production thật: false
DEMO_OTP=true
# Cho phép đăng nhập demo 1-click & Google Mock
ENABLE_DEMO_AUTH=true
REPORTS_PER_HOUR=3
AI_VISION_PER_HOUR=10
# Thư mục chứa store.json khi dùng Local JSON Store
DATA_DIR=./data

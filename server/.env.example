# ==============================================================================
# SmartCitizen Đồng Nai — Backend Environment Variables (server/.env.example)
# ==============================================================================
# Sao chép sang server/.env để chạy local. KHÔNG commit file server/.env lên Git!

# ── Google AI Studio (Tùy chọn — để trống sẽ dùng AI Dự phòng Cục bộ) ─────────
# Lấy key tại https://aistudio.google.com/apikey (dạng AIza..., KHÔNG đưa vào client)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# ── Cơ sở dữ liệu (Tùy chọn — để trống sẽ dùng Local Persistent JSON Store) ──
# Định dạng chuẩn: mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/smartcitizen_dongnai?retryWrites=true&w=majority
MONGODB_URI=
# Thư mục chứa store.json khi dùng Local JSON Store
DATA_DIR=./data

# ── Bảo mật & CORS ────────────────────────────────────────────────────────────
# BẮT BUỘC >= 32 ký tự khi NODE_ENV=production.
# Sinh chuỗi ngẫu nhiên 64 ký tự hex: openssl rand -hex 32
JWT_SECRET=replace_with_a_random_secret_at_least_32_characters_long
# Danh sách origin được phép gọi API (phân tách bằng dấu phẩy, hỗ trợ wildcard *)
ALLOWED_ORIGINS=http://localhost:5173,https://*.onrender.com

# ── Vận hành & Rate Limiting ──────────────────────────────────────────────────
# Giá trị hợp lệ: development | production | test
NODE_ENV=development
# Số nguyên 1–65535 (trên Render hệ thống tự động cấp PORT)
PORT=8080
# Trả mã OTP trong response (nhãn [DEMO OTP]) để Ban Giám Khảo thử không tốn phí SMS. Production thật: false
DEMO_OTP=true
# Cho phép đăng nhập demo 1-click & Google Mock. Production thật: false
ENABLE_DEMO_AUTH=true
# Giới hạn gửi phản ánh & gọi AI Vision mỗi giờ (số nguyên dương 1–1000)
REPORTS_PER_HOUR=3
AI_VISION_PER_HOUR=10

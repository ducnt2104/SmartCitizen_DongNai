# ==============================================================================
# SmartCitizen Đồng Nai — Cấu hình Frontend (frontend/.env)
# ==============================================================================
# Lưu ý trên Render (Single-Service): khai báo biến VITE_GOOGLE_MAPS_API_KEY
# trực tiếp trong mục Environment Variables của Web Service trước khi Build.

# ── 1. Google Maps Platform (Primary GIS Engine — Khuyến nghị bật đầy đủ) ─────
# Trên Google Cloud Console -> APIs & Services -> Library, bật 3 API sau:
#   1) Maps JavaScript API  (Hiển thị Vector Map 60FPS, Vệ tinh Hybrid & AdvancedMarker)
#   2) Places API           (Tìm kiếm tự động số nhà, con hẻm, địa danh TP. Đồng Nai)
#   3) Geocoding API        (Reverse Geocoding tọa độ sang địa chỉ chính xác từng mét)
# Bảo mật bắt buộc (Application Restrictions -> Websites / HTTP Referrers):
#   - https://smartcitizen-dongnai.onrender.com/*
#   - http://localhost:5173/*
# Nếu để trống hoặc key bị từ chối domain, ứng dụng TỰ ĐỘNG fallback sang MapLibre GL JS (không crash).
VITE_GOOGLE_MAPS_API_KEY=

# Map ID cho Google Vector Map & AdvancedMarker (tùy chọn, mặc định dùng DEMO_MAP_ID)
VITE_GOOGLE_MAPS_MAP_ID=

# ── 2. Backend API Origin (Chỉ dùng khi tách riêng Frontend khỏi Backend) ─────
# Để trống khi dùng cùng origin trên Render hoặc Vite proxy local (http://localhost:8080).
VITE_API_BASE=

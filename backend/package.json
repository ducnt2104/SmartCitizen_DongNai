    "db:verify": "tsx src/scripts/verifyDb.ts"
  },
  "dependencies": {
    "@google/genai": "^3.6.1",
    "compression": "^1.8.2",
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "express": "^4.22.3",
    "express-rate-limit": "^7.5.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.24.11",
    "nodemailer": "^10.6.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.6",
    "@types/nodemailer": "^8.0.2",
    "mongodb-memory-server": "^11.4.0",
    "tsx": "^4.23.15",

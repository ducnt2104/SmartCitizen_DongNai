# ==============================================================================
# SmartCitizen Đồng Nai — Backend Environment Variables (backend/.env.example)
# ==============================================================================
# Sao chép sang backend/.env để chạy local. KHÔNG commit file backend/.env lên Git!

# ── Môi trường & Cổng dịch vụ ─────────────────────────────────────────────────
NODE_ENV=development
PORT=8080

# ── Bảo mật JWT, Phiên & CORS ─────────────────────────────────────────────────
# BẮT BUỘC >= 32 ký tự khi NODE_ENV=production. Sinh nhanh: openssl rand -hex 32
JWT_SECRET=replace_with_a_random_secret_at_least_32_characters_long
OTP_PEPPER=
REFRESH_TOKEN_DAYS=7
COOKIE_SECURE=false
ALLOWED_ORIGINS=http://localhost:5173,https://*.onrender.com

# ── Cơ sở dữ liệu MongoDB Atlas (để trống sẽ dùng Local Persistent JSON Store)
MONGODB_URI=
DATA_DIR=./data

# ── Dịch vụ gửi OTP THẬT (Zero Mock Auth / Zero Fake OTP) ─────────────────────
# Giá trị: auto | resend | smtp | twilio | esms
OTP_PROVIDER=auto

# Tùy chọn 1 (Khuyến nghị): Resend Email API
RESEND_API_KEY=
OTP_FROM_EMAIL=SmartCitizen Dong Nai <onboarding@resend.dev>

# Tùy chọn 2 (Miễn phí với Gmail): SMTP Nodemailer
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=

# Tùy chọn 3 (SMS mở rộng): Twilio hoặc eSMS Việt Nam
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
ESMS_API_KEY=
ESMS_SECRET_KEY=
ESMS_BRANDNAME=

# ── Mật khẩu khởi tạo tài khoản Cán bộ IOC 2 cấp ──────────────────────────────
# Đặt mật khẩu mạnh >= 12 ký tự cho production (CITY_ADMIN TP-01 & các WARD_OFFICER khởi tạo)
INITIAL_STAFF_PASSWORD=

# ── Google AI Studio / Gemini & Multi-API Key Rotation Pool ──────────────────
# Hỗ trợ nạp 10+ API key phân tách dấu phẩy (GEMINI_API_KEYS="key1,key2,...,key10"),
# hoặc GEMINI_API_KEY_1..10 và fallback GEMINI_API_KEY để tự động xoay vòng khi chạm 429
GEMINI_API_KEYS=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
# Khóa mã hóa đối xứng AES-256-GCM cho các API key lưu trong MongoDB (sinh bằng: openssl rand -hex 32)
KEY_ENCRYPTION_SECRET=replace_with_a_random_32_byte_aes_encryption_secret
KEY_QUOTA_RESET_TZ=Asia/Ho_Chi_Minh

# ── Giới hạn tần suất (Rate Limiting) ─────────────────────────────────────────
REPORTS_PER_HOUR=3
AI_VISION_PER_HOUR=10

# ==============================================================================
# SmartCitizen Đồng Nai — Mẫu cấu hình biến môi trường (.env.example)
# ==============================================================================
# Sao chép file này sang `.env` (hoặc `backend/.env`) khi chạy local.
# TUYỆT ĐỐI KHÔNG commit file `.env` chứa khóa bí mật thật lên GitHub!

# ── 1. Môi trường & Cổng dịch vụ Backend ──────────────────────────────────────
NODE_ENV=development
PORT=8080

# ── 2. Bảo mật JWT, Phiên & CORS ──────────────────────────────────────────────
# Sinh chuỗi ngẫu nhiên >= 32 ký tự: openssl rand -hex 32
JWT_SECRET=
OTP_PEPPER=
REFRESH_TOKEN_DAYS=7
COOKIE_SECURE=false
ALLOWED_ORIGINS=http://localhost:5173,https://*.onrender.com

# ── 3. MongoDB Atlas Real Persistence (Không rơi về Mock ngầm!) ───────────────
# Khi điền MONGODB_URI, hệ thống BẮT BUỘC lưu thật xuống MongoDB Atlas.
# Để trống chỉ khi chạy thử nghiệm cục bộ bằng JSON Store.
MONGODB_URI=
ALLOW_JSON_FALLBACK=false
DATA_DIR=./data

# ── 4. High-Speed Rust Computer Vision & ONNX Engine (`engine/`) ──────────────
CV_ENGINE_URL=http://127.0.0.1:8001
CV_ENGINE_PORT=8001
AUTO_SPAWN_CV_ENGINE=true

# ── 5. Local LLM Router (Ollama / llama.cpp) & Multi-API Key Rotation Pool ────
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b
LLAMA_CPP_BASE_URL=
# Chỉ gọi Cloud AI khi cờ dưới đây đặt `true` và Local LLM đang tắt
ALLOW_CLOUD_AI_FALLBACK=false
# Hỗ trợ nạp 10+ API key phân tách dấu phẩy để xoay vòng tức thì khi chạm 429 / hết RPD
GEMINI_API_KEYS=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
# Khóa bí mật mã hóa đối xứng AES-256-GCM cho API key do Admin nạp qua Dashboard (>= 32 ký tự)
KEY_ENCRYPTION_SECRET=
KEY_QUOTA_RESET_TZ=Asia/Ho_Chi_Minh

# ── 6. Tài khoản SUPER_ADMIN & Cán bộ IOC Khởi tạo ───────────────────────────
SUPER_ADMIN_CODE=SUPER-ADMIN
SUPER_ADMIN_EMAIL=superadmin@dongnai.gov.vn
SUPER_ADMIN_PASSWORD=
INITIAL_STAFF_PASSWORD=

# ── 7. Dịch vụ gửi OTP THẬT (auto | resend | brevo | webhook | smtp | twilio | esms)
OTP_PROVIDER=auto
RESEND_API_KEY=
BREVO_API_KEY=
OTP_FROM_EMAIL=
OTP_WEBHOOK_URL=
OTP_WEBHOOK_SECRET=
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
ESMS_API_KEY=
ESMS_SECRET_KEY=
ESMS_BRANDNAME=

# ── 8. Giới hạn tần suất (Rate Limiting) ──────────────────────────────────────
REPORTS_PER_HOUR=3
AI_VISION_PER_HOUR=10

# ── 9. Cấu hình Frontend (`frontend/.env`) ────────────────────────────────────
VITE_API_BASE=http://localhost:8080
VITE_GOOGLE_MAPS_API_KEY=
VITE_GOOGLE_MAPS_MAP_ID=

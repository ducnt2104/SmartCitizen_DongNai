# ==============================================================================
# SmartCitizen Đồng Nai — Mẫu cấu hình biến môi trường (.env.example)
# ==============================================================================
# Chỉ chứa tên biến mẫu, KHÔNG chứa khóa bí mật thật!
# - Người A (Backend): sao chép các biến Backend sang `backend/.env` khi chạy local.
# - Người B (Frontend): sao chép các biến VITE_* sang `frontend/.env` khi chạy local.
# TUYỆT ĐỐI KHÔNG commit bất kỳ file `.env` nào lên GitHub!

# ── 1. Môi trường & Cổng dịch vụ Backend ──────────────────────────────────────
NODE_ENV=development
PORT=8080

# ── 2. Bảo mật JWT, Phiên & CORS (BẮT BUỘC ở Production) ──────────────────────
# Sinh chuỗi ngẫu nhiên >= 32 ký tự: openssl rand -hex 32
JWT_SECRET=
OTP_PEPPER=
REFRESH_TOKEN_DAYS=7
COOKIE_SECURE=false
ALLOWED_ORIGINS=http://localhost:5173,https://*.onrender.com

# ── 3. Cơ sở dữ liệu MongoDB Atlas (Tùy chọn — có Fallback Local JSON Store) ──
MONGODB_URI=
DATA_DIR=./data

# ── 4. Dịch vụ gửi OTP THẬT (auto | resend | brevo | webhook | smtp | twilio | esms)
OTP_PROVIDER=auto

# 4a) Email OTP qua Resend / Brevo / HTTPS Webhook
RESEND_API_KEY=
BREVO_API_KEY=
OTP_FROM_EMAIL=
OTP_WEBHOOK_URL=
OTP_WEBHOOK_SECRET=

# 4b) Email OTP qua SMTP
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=

# 4c) SMS OTP qua Twilio / eSMS (Tùy chọn)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
ESMS_API_KEY=
ESMS_SECRET_KEY=
ESMS_BRANDNAME=

# ── 5. Mật khẩu khởi tạo tài khoản Cán bộ IOC 2 cấp ──────────────────────────
INITIAL_STAFF_PASSWORD=

# ── 6. Google AI Studio / Gemini & Multi-API Key Rotation Pool ───────────────
# Hỗ trợ nạp 10+ API key phân tách dấu phẩy để xoay vòng tức thì khi chạm 429 / hết RPD
GEMINI_API_KEYS=
# Hoặc khai báo từng biến GEMINI_API_KEY_1..10 và fallback GEMINI_API_KEY đơn lẻ:
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
# Khóa bí mật mã hóa đối xứng AES-256-GCM cho API key do Admin nạp qua Dashboard (>= 32 ký tự: openssl rand -hex 32)
KEY_ENCRYPTION_SECRET=
KEY_QUOTA_RESET_TZ=Asia/Ho_Chi_Minh

# ── 7. Giới hạn tần suất (Rate Limiting) ──────────────────────────────────────
REPORTS_PER_HOUR=3
AI_VISION_PER_HOUR=10

# ── 8. Cấu hình Frontend (frontend/.env) ──────────────────────────────────────
VITE_API_BASE=http://localhost:8080
VITE_GOOGLE_MAPS_API_KEY=
VITE_GOOGLE_MAPS_MAP_ID=

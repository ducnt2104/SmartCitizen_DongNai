# ==============================================================================
# SmartCitizen Đồng Nai — Mẫu cấu hình biến môi trường (Root Monorepo)
# ==============================================================================
# Sao chép file này sang server/.env (hoặc .env ở thư mục gốc) khi chạy local.
# TUYỆT ĐỐI KHÔNG commit file .env chứa khóa bí mật thật lên GitHub!
# Trên Render: khai báo các biến này tại Dashboard -> Environment Variables
# hoặc triển khai trực tiếp qua Blueprint (render.yaml).

# ── 1. Môi trường & Cổng dịch vụ ──────────────────────────────────────────────
# Giá trị hợp lệ: development | production | test
NODE_ENV=development
# Số nguyên 1–65535 (mặc định 8080; trên Render để nền tảng tự cấp PORT)
PORT=8080

# ── 2. Bảo mật & CORS (BẮT BUỘC ở Production) ─────────────────────────────────
# BẮT BUỘC >= 32 ký tự khi NODE_ENV=production.
# Lệnh tạo nhanh: openssl rand -hex 32
# Hoặc: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_with_a_random_secret_at_least_32_characters_long

# Danh sách domain frontend được phép gọi API (ngăn cách bằng dấu phẩy, hỗ trợ wildcard *)
# Ví dụ production: https://smartcitizen-dongnai.onrender.com,https://*.onrender.com
ALLOWED_ORIGINS=http://localhost:5173,https://*.onrender.com

# ── 3. Cơ sở dữ liệu MongoDB Atlas (Tùy chọn — có Fallback Local JSON Store) ──
# Định dạng: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/smartcitizen_dongnai?retryWrites=true&w=majority
# Nếu để trống, backend tự động dùng Local Persistent JSON Store trong DATA_DIR.
MONGODB_URI=
# Thư mục lưu store.json khi chạy chế độ Local JSON Store
DATA_DIR=./data

# ── 4. Google AI Studio / Gemini (Tùy chọn — có Fallback AI Cục bộ) ───────────
# Lấy API Key tại https://aistudio.google.com/apikey (dạng AIza...)
# Nếu để trống, backend tự động dùng Chế độ AI Dự phòng Cục bộ.
GEMINI_API_KEY=
# Tên model Gemini mặc định (không để rỗng)
GEMINI_MODEL=gemini-3.5-flash

# ── 5. Chế độ Demo & Giới hạn tần suất (Rate Limiting) ────────────────────────
# Giá trị hợp lệ: true | false
# Khuyến nghị đặt false khi vận hành production thực tế cho người dân
DEMO_OTP=true
ENABLE_DEMO_AUTH=true
# Số nguyên dương 1–1000
REPORTS_PER_HOUR=3
AI_VISION_PER_HOUR=10

# ── 6. Frontend (client/.env — chỉ dùng khi tách riêng Frontend khỏi Backend) ─
# Để trống khi deploy 1 dịch vụ gộp trên Render (Express phục vụ sẵn client/dist).
# Khi tách riêng, đặt URL backend (vd: https://smartcitizen-dongnai.onrender.com)
# KHÔNG đặt bất kỳ khóa bí mật nào vào biến VITE_*!
VITE_API_BASE=

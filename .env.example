# ==============================================================================
# SmartCitizen Đồng Nai — Mẫu cấu hình biến môi trường (Root Monorepo)
# ==============================================================================
# Sao chép file này sang server/.env khi chạy local.
# TUYỆT ĐỐI KHÔNG commit file .env chứa khóa bí mật thật lên GitHub!
# Trên Render: khai báo các biến này tại Dashboard -> Environment Variables
# hoặc triển khai trực tiếp qua Blueprint (render.yaml).

# ── 1. Môi trường & Cổng dịch vụ ──────────────────────────────────────────────
# Giá trị hợp lệ: development | production | test
NODE_ENV=development
PORT=8080

# ── 2. Bảo mật JWT, Phiên & CORS (BẮT BUỘC ở Production) ──────────────────────
# BẮT BUỘC >= 32 ký tự khi NODE_ENV=production.
# Lệnh tạo nhanh: openssl rand -hex 32
JWT_SECRET=replace_with_a_random_secret_at_least_32_characters_long
# Pepper bổ sung để băm HMAC-SHA256 mã OTP (nếu để trống sẽ dẫn xuất từ JWT_SECRET)
OTP_PEPPER=
# Số ngày hiệu lực của Refresh Token HTTP-only Cookie (1–90, mặc định 7)
REFRESH_TOKEN_DAYS=7
# Bật cờ Secure cho HTTP-only Cookie (production HTTPS mặc định true; local HTTP dùng false)
COOKIE_SECURE=false

# Danh sách domain frontend được phép gọi API (ngăn cách bằng dấu phẩy, hỗ trợ wildcard *)
ALLOWED_ORIGINS=http://localhost:5173,https://*.onrender.com

# ── 3. Cơ sở dữ liệu MongoDB Atlas (Tùy chọn — có Fallback Local JSON Store) ──
# Định dạng: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/smartcitizen_dongnai?retryWrites=true&w=majority
MONGODB_URI=
DATA_DIR=./data

# ── 4. Dịch vụ gửi OTP THẬT (Zero Fake OTP — chọn Email Resend/SMTP hoặc SMS) ─
# Giá trị OTP_PROVIDER: auto | resend | smtp | twilio | esms
# Khuyến nghị mặc định: `auto` + cấu hình RESEND_API_KEY hoặc SMTP (Gmail App Password) để gửi Email OTP miễn phí.
OTP_PROVIDER=auto

# 4a) Email OTP qua Resend (https://resend.com — miễn phí 3.000 email/tháng)
RESEND_API_KEY=
OTP_FROM_EMAIL=SmartCitizen Dong Nai <onboarding@resend.dev>

# 4b) Email OTP qua SMTP (Gmail App Password / Brevo / SMTP cơ quan)
# Với Gmail: bật xác minh 2 bước -> tạo App Password 16 ký tự tại myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=

# 4c) SMS OTP qua Twilio (tùy chọn mở rộng)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# 4d) SMS OTP qua eSMS Việt Nam (tùy chọn mở rộng)
ESMS_API_KEY=
ESMS_SECRET_KEY=
ESMS_BRANDNAME=

# ── 5. Mật khẩu khởi tạo tài khoản Cán bộ IOC 2 cấp (CITY_ADMIN / WARD_OFFICER)
# Khuyến nghị đặt mật khẩu mạnh >= 12 ký tự trên Render Dashboard.
# Sau khi đăng nhập CITY_ADMIN (TP-01), có thể tạo/thu hồi tài khoản Cán bộ 95 Phường/Xã ngay trên giao diện IOC.
INITIAL_STAFF_PASSWORD=

# ── 6. Google AI Studio / Gemini (Tùy chọn — có Fallback AI Cục bộ) ───────────
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# ── 7. Giới hạn tần suất (Rate Limiting) ──────────────────────────────────────
REPORTS_PER_HOUR=3
AI_VISION_PER_HOUR=10

# ── 8. Frontend & Bản đồ GIS Google Maps (Khai báo trên Render Dashboard hoặc client/.env) ─
# Bật 3 API trên Google Cloud Console: Maps JavaScript API, Places API, Geocoding API.
# Giới hạn HTTP Referrers: https://smartcitizen-dongnai.onrender.com/* và http://localhost:5173/*
# Nếu chưa điền key, hệ thống tự động chạy chế độ dự phòng MapLibre GL JS (0% trắng trang).
VITE_GOOGLE_MAPS_API_KEY=
VITE_GOOGLE_MAPS_MAP_ID=
VITE_API_BASE=
